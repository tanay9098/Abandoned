# --- Core ---------------------------------------------------------------
# Secret used to sign session cookies (min 32 chars). REQUIRED in production.
SESSION_SECRET=
# Bearer secret protecting /api/jobs/* (used by the scheduler). REQUIRED in production.
CRON_SECRET=
# PostgreSQL / Supabase connection string. If unset, a local PGlite demo database is used (.data/pglite).
DATABASE_URL=

# --- Google Calendar (read-only) -----------------------------------------
# Leave unset to use the clearly-labelled demo calendar (non-production only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorised redirect URI, e.g. http://localhost:3000/api/calendar/callback
GOOGLE_REDIRECT_URI=
# 32-byte key, base64 or hex, used to encrypt stored OAuth tokens (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=
# Force the demo calendar provider on (1) or off (0).
GOOGLE_CALENDAR_MOCK=

# --- Optional AI ghost dialogue (open-weight Gemma) -----------------------
# Any OpenAI-compatible Chat Completions endpoint. Leave AI_BASE_URL empty to use the built-in lines.
# The core app never needs it. Examples:
#   Local Ollama (no key):  AI_BASE_URL=http://localhost:11434/v1                                AI_MODEL=gemma3:4b
#   Google AI Studio:       AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemma-3-27b-it
#   Hugging Face router:    AI_BASE_URL=https://router.huggingface.co/v1                         AI_MODEL=google/gemma-3-27b-it
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemma3:4b
# Request timeout in ms (default 4000). Raise it (e.g. 15000) for local CPU inference.
AI_TIMEOUT_MS=

# --- Testing only (never set in production) -------------------------------
# Allows the X-Test-Now header to override the server clock (used by Playwright).
ABANDONMENT_ALLOW_TEST_CLOCK=
